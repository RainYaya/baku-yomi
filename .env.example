# Server
PORT=3003

# TTS
VOICEVOX_ENGINE_URL=http://localhost:50021
TTS_CACHE_MAX_BYTES=125829120     # 120 MB

# TTS worker (the LAN machine that generates audiobooks)
# Set to the desktop running `pnpm tts:worker`, not to this server.
# BAKU_TTS_WORKER=http://<desktop-ip>:3910
# BAKU_IMPORT_TOKEN=change-me
#
# On the worker machine itself (.env next to pnpm tts:worker):
# VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_MODEL=omnivoice
# VOICESTUDIO_VOICE=default
# When VoiceStudio is reached over the LAN (its sharing toggle listens on 3901):
# VOICESTUDIO_URL=http://<desktop-ip>:3901
# VOICESTUDIO_PIN=<the 6-digit PIN VoiceStudio shows for that session>
# BAKU_TTS_BITRATE=32k
# BAKU_TTS_PORT=3910
# BAKU_ROG_URL=http://192.168.210.203:3003
# BAKU_IMPORT_TOKEN=change-me

# CORS (production only — omit to allow same-origin only)
# CORS_ORIGIN=https://your-domain.example.com

# AI keys (optional — the app uses BYOK by default)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
